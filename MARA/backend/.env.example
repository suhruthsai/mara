GROQ_API_KEY=your_groq_api_key_here
# Optional: override the Groq model used by every agent (see https://console.groq.com/docs/models)
# GROQ_MODEL=openai/gpt-oss-120b
# Optional: Semantic Scholar key (avoids HTTP 429 rate limits) - https://www.semanticscholar.org/product/api
# SEMANTIC_SCHOLAR_API_KEY=
# Optional: comma-separated origins allowed to call the REST API
# CORS_ORIGINS=http://localhost:3000
# Optional: LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langchain_api_key_here
